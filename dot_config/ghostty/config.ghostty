config-file = ?dye

window-decoration = none
gtk-titlebar = false
window-padding-x = 8
window-padding-y = 8
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true

theme = Treehouse
font-family = "FiraCode Nerd Font"
font-size = 12
font-feature = +calt
font-feature = +liga

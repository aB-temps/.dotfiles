{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin": "24 24 0 24",
    "spacing": 16,
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-right": ["cpu", "memory", "pulseaudio", "battery", "clock"],
 
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": { "active": "◉", "default": "●" }
    },
    "niri/window": { "max-length": 60 },
    "cpu": { "format": "cpu {usage}%", "interval": 5 },
    "memory": { "format": "ram {used:0.1f}G", "interval": 10 },
    "pulseaudio": { "format": "vol {volume}%", "format-muted": "vol off" },
    "battery": {
        "format": "bat {capacity}%",
        "states": { "warning": 25, "critical": 10 }
    },
    "clock": { "format": "{:%H:%M}", "tooltip-format": "{:%A %d %B %Y}" }
}
